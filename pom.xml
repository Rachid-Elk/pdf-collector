<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>pdf-collector</artifactId>
    <version>1.0.0</version>
    <name>PDF Collector JavaFX</name>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- JavaFX 21 -->
        <javafx.version>21.0.5</javafx.version>

        <!-- Main -->
        <main.class>com.example.pdfcollector.MainApp</main.class>

        <!-- App metadata -->
        <app.name>PDFCollector</app.name>
        <app.vendor>MyCompany</app.vendor>

        <!-- Icon -->
        <icon.path>${project.basedir}/src/main/resources/icon.ico</icon.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Compiler Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- Dev run: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- jpackage plugin (executed in profiles) -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.7.3</version>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <!-- =========================
             Portable APP_IMAGE build
             mvn -Ppackage clean package
             output: target/dist/PDFCollector/
             Fix: input != output to avoid infinite nesting
             ========================= -->
        <profile>
            <id>package</id>
            <build>
                <plugins>

                    <!-- 1) jlink => creates target/jlink -->
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <mainClass>${main.class}</mainClass>
                                    <jlinkImageName>jlink</jlinkImageName>
                                    <launcher>${app.name}</launcher>

                                    <stripDebug>true</stripDebug>
                                    <noHeaderFiles>true</noHeaderFiles>
                                    <noManPages>true</noManPages>
                                    <compress>2</compress>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2) Copy only the JAR into a dedicated input folder for jpackage -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-jar-to-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3) jpackage APP_IMAGE (output in target/dist, input is target/jpackage-input) -->
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>APP_IMAGE</type>

                                    <name>${app.name}</name>
                                    <appVersion>${project.version}</appVersion>
                                    <vendor>${app.vendor}</vendor>

                                    <!-- minimal runtime created by jlink -->
                                    <runtimeImage>${project.build.directory}/jlink</runtimeImage>

                                    <!-- Output folder (NOT inside input) -->
                                    <destination>${project.build.directory}/dist</destination>
                                    <removeDestination>true</removeDestination>

                                    <!-- Dedicated input folder -->
                                    <input>${project.build.directory}/jpackage-input</input>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>

                                    <!-- Windows -->
                                    <winConsole>false</winConsole>
                                    <icon>${icon.path}</icon>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <!-- =========================
             MSI installer build
             mvn -Pmsi clean package
             output: target/installer/*.msi
             Fix: input != output to avoid nesting
             Requires WiX 3.11 in PATH (candle.exe + light.exe)
             ========================= -->
        <profile>
            <id>msi</id>
            <build>
                <plugins>

                    <!-- 1) jlink => creates target/jlink -->
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <mainClass>${main.class}</mainClass>
                                    <jlinkImageName>jlink</jlinkImageName>
                                    <launcher>${app.name}</launcher>

                                    <stripDebug>true</stripDebug>
                                    <noHeaderFiles>true</noHeaderFiles>
                                    <noManPages>true</noManPages>
                                    <compress>2</compress>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2) Copy only the JAR into a dedicated input folder for jpackage -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-jar-to-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3) jpackage MSI -->
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <executions>
                            <execution>
                                <id>jpackage-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>MSI</type>

                                    <name>${app.name}</name>
                                    <appVersion>${project.version}</appVersion>
                                    <vendor>${app.vendor}</vendor>

                                    <runtimeImage>${project.build.directory}/jlink</runtimeImage>

                                    <destination>${project.build.directory}/installer</destination>
                                    <removeDestination>true</removeDestination>

                                    <!-- Dedicated input folder -->
                                    <input>${project.build.directory}/jpackage-input</input>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>

                                    <winMenu>true</winMenu>
                                    <winShortcut>true</winShortcut>
                                    <winDirChooser>true</winDirChooser>
                                    <winConsole>false</winConsole>

                                    <icon>${icon.path}</icon>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>